# このファイルを .env にコピーして値を入れる（.env はコミットしない）
# 取得手順は docs/setup-guide.md を参照
# アカウント名・ストアフロントURLなど秘密じゃない設定は content/account.json に書く

# --- Gemini（画像生成）---
GEMINI_API_KEY=
NANOBANANA_MODEL=gemini-3-pro-image-preview

# --- Supabase Storage（Instagramに渡す画像の公開置き場）---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=ig-images

# --- Instagram API with Instagram Login ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v25.0
