# このファイルを .env にコピーして値を入れる（.env はコミットしない）
# 取得手順は docs/setup-guide.md を参照
# アカウント名・トラッキングID・リンク集ページのURLなど秘密じゃない設定は content/account.json に書く

# --- OpenAI（イラスト生成。ChatGPT のサブスクとは別の従量課金）---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low / medium / high（medium で1枚5〜8円くらい）
OPENAI_IMAGE_QUALITY=medium

# --- Supabase Storage（Instagramに渡す画像の公開置き場）---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=ig-images

# --- Instagram API with Instagram Login ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v25.0

# --- スライドのフォントを置く英数字だけのフォルダ（空なら C:/Users/Public/amazon-ig-fonts）---
FONT_CACHE_DIR=
